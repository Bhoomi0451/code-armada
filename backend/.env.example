# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017/code_armada
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/code_armada?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/code_armada

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min32chars
JWT_EXPIRE=7d

# CORS Allowed Origin (e.g. Vite React frontend)
CORS_ORIGIN=http://localhost:5173
